// This has to be in the root otherwise the VSCode plugin will not work out of the box.
{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		// We repeat the editorconfig settings here because biome has spotty mono-repo support.
		// "useEditorconfig": true,
		"lineWidth": 120,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf"
	},
	"overrides": [
		{
			// Generated by napi-rs, which imports Node builtins without the node: prefix.
			"includes": ["js/web-transport/napi.cjs"],
			"linter": {
				"rules": {
					"style": {
						"useNodejsImportProtocol": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	// Markdown and YAML are hand-written or generated by release-plz and quest.
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"yaml": {
		"formatter": {
			"enabled": false
		}
	}
}
